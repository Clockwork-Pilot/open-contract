{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-contracts.dev/schemas/generated-data.schema.json",
  "title": "Open Contract generated data schema",
  "description": "Supported JSON Schema subset accepted by the standalone dataset generator.",
  "$ref": "#/$defs/dataSchema",
  "$defs": {
    "dataSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "$id": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "type": {
          "oneOf": [
            {"enum": ["null", "boolean", "object", "array", "number", "integer", "string"]},
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["null", "boolean", "object", "array", "number", "integer", "string"]}
            }
          ]
        },
        "const": true,
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": true
        },
        "examples": {
          "type": "array",
          "items": true
        },
        "properties": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/dataSchema"}
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "items": {"$ref": "#/$defs/dataSchema"},
        "prefixItems": {
          "type": "array",
          "items": {"$ref": "#/$defs/dataSchema"}
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "exclusiveMinimum": {"type": "number"},
        "exclusiveMaximum": {"type": "number"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0}
      },
      "anyOf": [
        {"required": ["type"]},
        {"required": ["enum"]},
        {"required": ["const"]}
      ]
    }
  }
}
