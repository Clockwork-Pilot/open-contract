        "operation": "dataset-read-error"
      },
      "expected": {
        "error_contains": "No such file or directory"
      }
    },
    {
      "id": "exact-output",
      "input": {
        "dataset": {
          "version": 1,
          "cases": [
            {
              "id": "one",
              "input": {
                "value": 1
              },
              "expected": {
                "value": 1
              }
            }
          ]
        }
      },
      "expected": {
        "passed": true,
        "total": 1,
        "coverage_complete": true
      }
    },
    {
