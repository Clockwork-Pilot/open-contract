        "dataset": {
          "version": 1,
          "cases": [
            {
              "id": "one",
              "input": {
                "value": 1
              },
              "predicate": ".value == 1"
            }
          ]
        }
      },
      "expected": {
        "passed": true
      }
    },
    {
      "id": "expected-and-predicate",
