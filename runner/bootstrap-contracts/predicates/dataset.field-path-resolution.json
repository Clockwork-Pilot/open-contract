{
  "version": 1,
  "cases": [
    {
      "id": "dotted-path-quoted-object-keys",
      "input": {
        "json": {
          "a": {
            "b": {
              "c/d": {
                "~key": "found"
              }
            }
          }
        },
        "predicate": ".a.b[\"c/d\"][\"~key\"] == \"found\""
      },
      "expected": true
    },
    {
      "id": "dotted-path-array-index",
      "input": {
        "json": {
          "payload": {
            "items": [
              "first",
              "second"
            ]
          }
        },
        "predicate": ".payload.items.1 == \"second\""
      },
      "expected": true
    },
    {
      "id": "malformed-bracketed-object-key",
      "input": {
        "json": {
          "payload": {
            "bad~2key": 1
          }
        },
        "predicate": ".payload[\"bad~2key\" == 1"
      },
      "expected": false
    },
    {
      "id": "invalid-unqualified-field-path",
      "input": {
        "json": {
          "payload": 1
        },
        "predicate": "payload == 1"
      },
      "expected": false
    },
    {
      "id": "dotted-array-index-out-of-range",
      "input": {
        "json": {
          "items": [
            1
          ]
        },
        "predicate": "exists(.items.3)"
      },
      "expected": false
    },
    {
      "id": "dotted-scalar-traversal",
      "input": {
        "json": {
          "value": 1
        },
        "predicate": "exists(.value.child)"
      },
      "expected": false
    },
    {
      "id": "malformed-bracketed-key-in-exists",
      "input": {
        "json": {
          "bad~2key": 1
        },
        "predicate": "exists(. [\"bad~2key\")"
      },
      "expected": false
    },
    {
      "id": "missing-exists-close-parenthesis",
      "input": {
        "json": {
          "field": 1
        },
        "predicate": "exists(.field"
      },
      "expected": false
    },
    {
      "id": "malformed-empty-field-path",
      "input": {
        "json": {},
        "predicate": ". == 1"
      },
      "expected": false
    },
    {
      "id": "malformed-empty-dot-segment",
      "input": {
        "json": {
          "value": {
            "other": 1
          }
        },
        "predicate": ".value..other == 1"
      },
      "expected": false
    },
    {
      "id": "quoted-key-with-escaped-quote",
      "input": {
        "json": {
          "obj": {
            "a\"b": 1
          }
        },
        "predicate": ".obj[\"a\\\"b\"] == 1"
      },
      "expected": true
    },
    {
      "id": "malformed-open-key-selector",
      "input": {
        "json": {
          "obj": {}
        },
        "predicate": ".obj[ == 1"
      },
      "expected": false
    }
  ]
}
