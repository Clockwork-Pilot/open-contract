{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bootstrap contract dataset",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "coverage_fingerprint": {
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[a-f0-9]{32}$",
            "default": "00000000000000000000000000000000",
            "description": "Pinned by the implementor after the checker reports the runtime fingerprint."
          },
          "setup": { "type": "boolean", "default": false },
          "input": {},
          "expected": {},
          "predicate": { "type": "string", "minLength": 1 }
        },
        "anyOf": [{ "required": ["expected"] }, { "required": ["predicate"] }],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
