{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-contracts.dev/schemas/contract-manifest.v1.schema.json",
  "title": "Open Contract package manifest v1",
  "type": "object",
  "required": ["version", "name", "datasets", "coverage_sources", "filesystem"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "1"},
    "name": {"type": "string", "minLength": 1},
    "datasets": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/pathReference"}, {"$ref": "#/$defs/datasetDefinition"}]}, "uniqueItems": true},
    "coverage_sources": {"type": "array", "items": {"$ref": "#/$defs/coverageSourceReference"}, "uniqueItems": true, "description": "Package-relative public API implementation files or glob patterns. The runner resolves only the declared patterns."},
    "minimum_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100, "default": 100},
    "metadata": {"type": "object", "description": "Optional consumer-owned data. Open Contract preserves it but does not interpret it or use it to plan or execute contracts.", "additionalProperties": true},
    "supplemental_tests": {"type": "array", "items": {"$ref": "#/$defs/pathReference"}, "uniqueItems": true},
    "nested_contracts": {"type": "array", "items": {"$ref": "#/$defs/nestedManifestReference"}, "uniqueItems": true, "description": "Relative YAML manifest paths resolved from this manifest; paths may traverse to sibling contract packages."},
    "directories": {
      "type": "object",
      "description": "Named package-relative directory roots referenced as @alias/path.",
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
      "additionalProperties": {"$ref": "#/$defs/packagePath"}
    },
    "execution": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "language_adapter": {"$ref": "#/$defs/filesystemPath", "description": "Path to one language adapter runtime.yaml. The runner loads this exact file; its declared runtime resources are added to this contract command."},
    "filesystem": {
      "type": "object",
      "required": ["read", "write"],
      "additionalProperties": false,
      "properties": {
        "read": {"type": "array", "items": {"$ref": "#/$defs/pathReference"}, "uniqueItems": true},
        "write": {"type": "array", "items": {"$ref": "#/$defs/pathReference"}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "datasetDefinition": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/pathReference"},
        "schema": {"$ref": "#/$defs/pathReference", "description": "YAML file containing this dataset's input and expected value schemas."}
      }
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"
    }
    ,
    "pathReference": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {"$ref": "#/$defs/packagePath"},
        {"pattern": "^@[A-Za-z][A-Za-z0-9_-]*(?:/[^*?\\[\\]]+)?$"}
      ],
      "description": "Package-relative path or @directory-alias/path reference."
    },
    "nestedManifestReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*//).+$",
      "description": "Relative YAML manifest path resolved from this manifest; .. components may reference another contract package."
    },
    "filesystemPath": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the contract directory or an absolute host path."
    },
    "coverageSourceReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:@[A-Za-z][A-Za-z0-9_-]*(?:/.*)?|[^/].*)$",
      "description": "Package-relative source file, source glob, or @directory-alias/path reference."
    }
  }
}
