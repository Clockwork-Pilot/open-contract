{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-contracts.dev/schemas/contract-manifest.v1.schema.json",
  "title": "Open Contract package manifest v1",
  "type": "object",
  "required": ["version", "name", "files", "filesystem"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "1"},
    "name": {"type": "string", "minLength": 1},
    "language_package": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Logical support package identifier resolved by runner configuration."
    },
    "files": {
      "type": "object",
      "required": ["dataset", "validator"],
      "additionalProperties": false,
      "properties": {
        "dataset": {"$ref": "#/$defs/packagePath"},
        "validator": {"$ref": "#/$defs/packagePath"},
        "support": {"type": "array", "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true},
        "supplemental_tests": {"type": "array", "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true},
        "nested_contracts": {"type": "array", "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_line_percent": {"type": "number", "minimum": 0, "maximum": 100, "default": 100}
      }
    },
    "execution": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "filesystem": {
      "type": "object",
      "required": ["read", "write"],
      "additionalProperties": false,
      "properties": {
        "read": {"type": "array", "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true},
        "write": {"type": "array", "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"
    }
  }
}
