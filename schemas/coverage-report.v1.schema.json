{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-contract.dev/schemas/coverage-report.v1.schema.json",
  "title": "Open Contract runner coverage artifact",
  "type": "object",
  "required": ["version", "contracts"],
  "properties": {
    "version": {"const": 1},
    "contracts": {
      "type": "array",
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["path", "metric", "location", "status", "count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "metric": {"enum": ["line", "statement", "function", "branch", "region", "instantiation"]},
        "name": {"type": ["string", "null"]},
        "location": {"$ref": "#/$defs/entityLocation"},
        "status": {"enum": ["covered", "uncovered", "unavailable"]},
        "count": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "entityLocation": {
      "type": "object",
      "required": ["precision", "start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "precision": {"enum": ["line", "column", "region", "unavailable"]},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "start_column": {"type": ["integer", "null"], "minimum": 0},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "end_column": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["contract", "status", "minimum_coverage_percent", "datasets", "sources", "union", "aggregate", "supplemental_tests", "native_report"],
      "properties": {
        "contract": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed"]},
        "minimum_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "datasets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sources": {
          "type": "object",
          "required": ["status", "declared", "covered", "missing"],
          "properties": {
            "status": {"enum": ["complete", "missing"]},
            "declared": {"type": "array", "items": {"type": "string"}},
            "covered": {"type": "array", "items": {"type": "string"}},
            "missing": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "union": {"$ref": "#/$defs/totals"},
        "aggregate": {"$ref": "#/$defs/totals"},
        "coverage_entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "supplemental_tests": {"type": ["object", "null"]},
        "native_report": true
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["covered_lines", "executable_lines", "percent", "metrics", "files"],
      "properties": {
        "covered_lines": {"type": "integer", "minimum": 0},
        "executable_lines": {"type": "integer", "minimum": 0},
        "percent": {"type": "number", "minimum": 0, "maximum": 100},
        "threshold_met": {"type": "boolean"},
        "metrics": {
          "type": "object",
          "required": ["line", "statement", "function", "branch", "region", "instantiation"],
          "properties": {
            "line": {"$ref": "#/$defs/metricOutcome"},
            "statement": {"$ref": "#/$defs/metricOutcome"},
            "function": {"$ref": "#/$defs/metricOutcome"},
            "branch": {"$ref": "#/$defs/metricOutcome"},
            "region": {"$ref": "#/$defs/metricOutcome"},
            "instantiation": {"$ref": "#/$defs/metricOutcome"}
          },
          "additionalProperties": false
        },
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
      },
      "additionalProperties": false
    },
    "metricOutcome": {
      "type": "object",
      "required": ["status", "covered", "total", "percent", "minimum_percent", "threshold_met", "files"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "covered": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "minimum_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "threshold_met": {"type": ["boolean", "null"]},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "covered", "total"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "covered": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["path", "executable_lines", "covered_lines", "uncovered_lines"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "executable_lines": {"$ref": "#/$defs/lines"},
        "covered_lines": {"$ref": "#/$defs/lines"},
        "uncovered_lines": {"$ref": "#/$defs/lines"}
      },
      "additionalProperties": false
    },
    "lines": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "uniqueItems": true
    }
  }
}
