#!/usr/bin/env python3
"""Run a command with a declared Landlock filesystem policy (Linux ABI 1-4)."""

import argparse
import ctypes
import os
import platform
import sys


SYSCALLS = {"x86_64": (444, 445, 446), "aarch64": (444, 445, 446)}
EXECUTE = 1 << 0
WRITE_FILE = 1 << 1
READ_FILE = 1 << 2
READ_DIR = 1 << 3
REMOVE_DIR = 1 << 4
REMOVE_FILE = 1 << 5
MAKE_CHAR = 1 << 6
MAKE_DIR = 1 << 7
MAKE_REG = 1 << 8
MAKE_SOCK = 1 << 9
MAKE_FIFO = 1 << 10
MAKE_BLOCK = 1 << 11
MAKE_SYM = 1 << 12
REFER = 1 << 13
TRUNCATE = 1 << 14
READ_ACCESS = EXECUTE | READ_FILE | READ_DIR
WRITE_ACCESS = (
    WRITE_FILE | REMOVE_DIR | REMOVE_FILE | MAKE_CHAR | MAKE_DIR | MAKE_REG
    | MAKE_SOCK | MAKE_FIFO | MAKE_BLOCK | MAKE_SYM | REFER | TRUNCATE
)
SUPPORTED_ABI = 4
O_PATH = getattr(os, "O_PATH", 0o10000000)


class RulesetAttr(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_uint64)]


class PathBeneathAttr(ctypes.Structure):
    _fields_ = [("allowed_access", ctypes.c_uint64), ("parent_fd", ctypes.c_int)]


def syscall(libc, number, *args):
    result = libc.syscall(number, *args)
    if result < 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    return result


def install(read_paths, write_paths):
    numbers = SYSCALLS.get(platform.machine())
    if numbers is None:
        raise RuntimeError(f"unsupported Landlock syscall architecture: {platform.machine()}")
    create_ruleset, add_rule, restrict_self = numbers
    libc = ctypes.CDLL(None, use_errno=True)
    abi = syscall(libc, create_ruleset, 0, 0, 1)  # LANDLOCK_CREATE_RULESET_VERSION
    if abi < 1 or abi > SUPPORTED_ABI:
        raise RuntimeError(f"Landlock ABI {abi} is unsupported; this launcher supports ABI 1-{SUPPORTED_ABI}")

    handled = (1 << 13) - 1
    if abi >= 2:
        handled |= REFER
    if abi >= 3:
        handled |= TRUNCATE
    ruleset_attr = RulesetAttr(handled)
    ruleset_fd = syscall(libc, create_ruleset, ctypes.byref(ruleset_attr), ctypes.sizeof(ruleset_attr), 0)
    try:
        for path, writable in [(p, False) for p in read_paths] + [(p, True) for p in write_paths]:
            canonical = os.path.realpath(path)
            if not os.path.exists(canonical):
                raise RuntimeError(f"allowed path does not exist: {path}")
            is_dir = os.path.isdir(canonical)
            parent = canonical if is_dir else os.path.dirname(canonical)
            ancestors = []
            while True:
                ancestors.append(parent)
                next_parent = os.path.dirname(parent)
                if next_parent == parent:
                    break
                parent = next_parent
            for directory in reversed(ancestors):
                add_path_rule(libc, add_rule, ruleset_fd, directory, EXECUTE)
            access = READ_ACCESS
            if writable:
                access |= WRITE_ACCESS if is_dir else WRITE_FILE | TRUNCATE
            if not is_dir:
                access &= ~READ_DIR
            add_path_rule(libc, add_rule, ruleset_fd, canonical, access & handled)

        syscall(libc, 157 if platform.machine() == "x86_64" else prctl_number(), 38, 1, 0, 0, 0)
        syscall(libc, restrict_self, ruleset_fd, 0)
    finally:
        os.close(ruleset_fd)


def prctl_number():
    # prctl is 167 on aarch64 and 172 on x86_64; x86_64 is handled directly above.
    return 167


def add_path_rule(libc, add_rule, ruleset_fd, path, access):
    fd = os.open(path, O_PATH | os.O_CLOEXEC)
    try:
        attr = PathBeneathAttr(access, fd)
        syscall(libc, add_rule, ruleset_fd, 1, ctypes.byref(attr), 0)  # PATH_BENEATH
    finally:
        os.close(fd)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--read", action="append", default=[], metavar="PATH", help="allow reading and executing this path")
    parser.add_argument("--write", action="append", default=[], metavar="PATH", help="allow reading, executing, and mutating this path")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("a command is required after --")
    if not args.read and not args.write:
        parser.error("at least one --read or --write path is required")
    try:
        install(args.read, args.write)
        os.closerange(3, 1 << 20)
        os.execvp(command[0], command)
    except (OSError, RuntimeError) as error:
        print(f"landlock-run: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
