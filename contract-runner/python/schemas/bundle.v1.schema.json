{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-contracts.dev/schemas/contract-bundle.v1.schema.json",
  "title": "Open Contracts v1 bundle",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "kind": {"type": "string", "minLength": 1},
    "config": {"type": "object"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
  },
  "oneOf": [
    {"required": ["cases"], "not": {"required": ["targets"]}},
    {"required": ["targets"], "not": {"required": ["cases"]}}
  ],
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "input"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "input": {},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sequenceStep"}
        },
        "expected": {},
        "predicate": {"$ref": "https://open-contracts.dev/schemas/predicate-language.schema.json"}
      },
      "oneOf": [
        {"required": ["expected"], "not": {"required": ["predicate"]}},
        {"required": ["predicate"], "not": {"required": ["expected"]}}
      ]
    },
    "sequenceStep": {
      "oneOf": [
        {"$ref": "#/$defs/actionStep"},
        {
          "type": "object",
          "required": ["parallel"],
          "additionalProperties": false,
          "properties": {
            "parallel": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/actionStep"}
            }
          }
        }
      ]
    },
    "actionStep": {
      "type": "object",
      "required": ["id", "input"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "input": {},
        "capture": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$"}
        },
        "expected": {},
        "predicate": {"$ref": "https://open-contracts.dev/schemas/predicate-language.schema.json"}
      },
      "oneOf": [
        {"required": ["expected"], "not": {"required": ["predicate"]}},
        {"required": ["predicate"], "not": {"required": ["expected"]}},
        {"not": {"anyOf": [{"required": ["expected"]}, {"required": ["predicate"]}]}}
      ]
    },
    "target": {
      "type": "object",
      "required": ["id", "kind", "cases"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "config": {"type": "object", "default": {}},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
      }
    }
  }
}
