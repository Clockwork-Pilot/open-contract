{
  "version": 1,
  "cases": [
    {
      "id": "greets-valid-name-exact",
      "input": {
        "name": "Ada",
        "member": { "active": true, "tier": "gold" }
      },
      "expected": {
        "greeting": "Hello, Ada!",
        "recipient": { "name": "Ada", "active": true, "tier": "gold" }
      }
    },
    {
      "id": "greets-hello-exact",
      "input": {
        "name": "hello",
        "member": { "active": false, "tier": "standard" }
      },
      "expected": {
        "greeting": "Hello, hello!",
        "recipient": { "name": "hello", "active": false, "tier": "standard" }
      }
    },
    {
      "id": "greets-grace-compound-predicate",
      "input": {
        "name": "Grace",
        "member": { "active": true, "tier": "silver" }
      },
      "predicate": "exists(.recipient.name) AND .recipient.name == \"Grace\" AND (.recipient.active == true OR .recipient.tier == \"silver\") AND NOT (.recipient.tier == \"blocked\") AND .greeting == \"Hello, Grace!\""
    },
    {
      "id": "greets-world-compound-predicate",
      "input": {
        "name": "world",
        "member": { "active": false, "tier": "standard" }
      },
      "predicate": "exists(.recipient.name) AND .recipient.name == \"world\" AND (.recipient.active == true OR .recipient.tier == \"standard\") AND NOT (.recipient.tier == \"blocked\") AND .greeting == \"Hello, world!\""
    }
  ]
}
